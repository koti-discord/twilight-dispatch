# Logging level (tracing EnvFilter syntax, e.g. "info" or "info,twilight_gateway=debug")
RUST_LOG=info

# Discord bot token. It also authenticates the REST requests: those at
# startup, the log channels below, and the messages that gateway.send
# deliveries with op 2 post (README, Operations).
BOT_TOKEN=

# Sharding information. Leave all three unset to run every shard Discord
# recommends (sessions are then not resumed across restarts).
SHARDS_START=0
SHARDS_END=1
SHARDS_TOTAL=2
# Optional upper bound for identify concurrency. Discord's max_concurrency
# (from GET /gateway/bot) is used when it is lower or when this is unset. A
# value that does not divide Discord's is lowered to the largest one that does
# (3 of 16 becomes 2), so shards Discord rate-limits together never identify
# together.
SHARDS_CONCURRENCY=1

# Optional. Publish only these dispatch events (comma-separated names, e.g.
# MESSAGE_CREATE,GUILD_CREATE,GUILD_DELETE); unset publishes every event. The
# others are still applied to the cache and still count as done, so the saved
# resume point keeps advancing; they are only not sent to the broker. An empty
# entry, or a name with anything but capital letters, digits and underscores,
# is a configuration error. A well-formed name this build does not know is
# accepted (events twilight does not model are published when this is unset)
# and logged as a warning at startup, so a typo is seen. Consumers that rely on events not listed here (such as the guild
# events a cache reader expects) stop receiving them.
# PUBLISH_EVENTS=MESSAGE_CREATE,GUILD_CREATE,GUILD_DELETE

# Chat source filter, off by default. With CHAT_FILTER=true a MESSAGE_CREATE is
# not published when its author is a bot, it came from a webhook, it is a DM,
# or it is a system message (only the types 0, default, and 19, reply, are
# chat). With CHAT_FILTER_WINDOW_SECS above 0, a message is also not published
# when a message of the same (guild, user) pair was published less than that
# many seconds ago; 0 (the default) has no per-pair window. A dropped message
# is still applied to the cache and still counts as done, like an event left
# out by PUBLISH_EVENTS (which is checked first). Counted in
# gateway_chat_filtered{reason}.
# The gateway's drop is final: the message is never published, and the
# consumer cannot get it back. So CHAT_FILTER_WINDOW_SECS should not be longer
# than the consumer's own cooldown for the same (guild, user), or messages the
# consumer would have accepted are lost. The filter remembers at most 1000000
# pairs (roughly 100 to 150 MB); with more live pairs a new one is published
# without being remembered.
# CHAT_FILTER=false
# CHAT_FILTER_WINDOW_SECS=0

# Compact MESSAGE_CREATE, off by default; needs CHAT_FILTER=true (the gateway
# refuses to start without it: the compact body has no author or bot flag, so
# without the filter a consumer could not tell bot messages apart). A published
# MESSAGE_CREATE then keeps the {"op", "t", "d"} envelope, the routing key and
# the message id, but d holds only guild_id, channel_id, parent_id (the parent
# channel when channel_id is a thread the state cache knows, otherwise null:
# with STATE_ENABLED=false it is always null), user_id, message_id, timestamp
# and dropped (how many messages of that (guild, user) pair the window dropped
# since the previous one published; a count that waited at least twice the
# CHAT_FILTER_WINDOW_SECS for the pair's next message is reported as 0). A
# MESSAGE_CREATE that does not fit, or that the filter cannot read, is not
# published (it is counted in gateway_compact_unreadable).
# COMPACT_MESSAGE_CREATE=false

# Declare the default gateway.recv queue bound to every event
DEFAULT_QUEUE=true

# Resume sessions after a restart
RESUME=true

# Identify payload. INTENTS accepts every intent Discord documents, including
# GUILD_MESSAGE_POLLS (1 << 24) and DIRECT_MESSAGE_POLLS (1 << 25).
INTENTS=32767
# 50 to 250. Only how much of a large guild its GUILD_CREATE lists: member
# requests (REQUEST_MEMBERS) ask for every guild's whole member list anyway.
LARGE_THRESHOLD=250
STATUS=online
ACTIVITY_TYPE=0
ACTIVITY_NAME=Testing
# Optional. For ACTIVITY_TYPE=4 (custom status) the text is shown from the
# state, which defaults to ACTIVITY_NAME. ACTIVITY_URL is for streaming (1).
ACTIVITY_STATE=
ACTIVITY_URL=

# Discord channel logs (empty or 0 disables them)
LOG_CHANNEL=
LOG_GUILD_CHANNEL=

# State configuration (TTLs in milliseconds; 0 means never expire)
STATE_ENABLED=true
STATE_MEMBER=true
# A cached member is deleted this long after it was last written, so with a
# TTL the cache holds only the members seen recently (a members chunk or
# member event writes them again). Read a guild's size from member_count in
# guild:<id>, not by counting member keys; 0 keeps members until they leave.
# With 0, a member that a guild's GUILD_CREATE after a new session does not
# list (Discord leaves out offline members above LARGE_THRESHOLD members, and
# lists only the bot and voice users of a guild over 75k members) is deleted
# 24 hours later, unless a members chunk or member event writes it again first
# (at once when the GUILD_CREATE lists every member).
STATE_MEMBER_TTL=60000
STATE_MESSAGE=true
STATE_MESSAGE_TTL=60000
STATE_PRESENCE=true
STATE_EMOJI=true
STATE_VOICE=true
# Attach the previous cached value as "old" to published events
STATE_OLD=false

# Guild member requests (gateway opcode 8). Each shard asks Discord for the
# whole member list of every one of its guilds itself, one guild at a time,
# whatever the guild's size or LARGE_THRESHOLD: all of them at every start
# (also when the shard resumes its saved session, which brings no READY or
# GUILD_CREATE: it starts from the guilds the cache has for it, so this part
# needs STATE_ENABLED), a guild again at each GUILD_CREATE (a join, the end of
# an outage, a new session), and every guild again once per
# MEMBER_REFRESH_HOURS (0 turns that off), each at its own time in that period
# so the refreshes are spread out. The members arrive as GUILD_MEMBERS_CHUNK
# events, cached and published like any other. Unset, requests are on when
# INTENTS has the GUILD_MEMBERS intent (2) and off without it, which a warning
# at startup reports; true without the intent is a configuration error, and
# false turns requests off. Turn off any other client's requests for the same
# bot first: Discord answers a second request for a guild within 30 s with
# RATE_LIMITED.
# REQUEST_MEMBERS=false
MEMBER_REFRESH_HOURS=24

# AMQP broker (LavinMQ / RabbitMQ). Alternatively set AMQP_URL, e.g.
# amqp://user:pass@host:5672/%2f?heartbeat=30
# Keep heartbeat=30 in AMQP_URL (the URL built from RABBIT_* has it): without
# it LavinMQ's default of 300 s applies and a dead connection is noticed only
# after about 10 minutes.
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/
# Publisher confirms: an event counts as published (and the saved resume
# point may pass it) only once the broker confirmed it, so a broker crash
# cannot lose events. Off by default because, when on, each worker waits for
# one broker disk sync per event, which caps a guild at roughly 200 events/s
# (README, Operations).
# AMQP_CONFIRMS=true

# Redis. Alternatively set REDIS_URL, e.g. redis://:pass@host:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Prometheus metrics and /healthcheck
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=8005

# Discord endpoints (optional; unset means Discord's own)
# Send REST requests to a proxy such as twilight-http-proxy instead of
# discord.com: http://host:port or https://host:port, without a path.
# DISCORD_API_PROXY=http://twilight-http-proxy:3000
# Connect new gateway sessions to a gateway proxy instead of
# wss://gateway.discord.gg: ws:// or wss://, a host, an optional port and
# path, no query or fragment (twilight appends
# /?v=10&encoding=json&compress=zstd-stream). Resumes still go to the
# resume URL Discord sent in READY.
# DISCORD_GATEWAY_URL=ws://gateway-proxy:7878

# Tuning (optional)
# Ordered workers that cache and publish events (events of one guild always
# use the same worker, so they stay in order). With AMQP_CONFIRMS each waits
# for the broker's confirm before its next event, so this bounds the publish
# rate: raise it (up to 1024) when shards log "Event queue is full" (README,
# Operations). Each worker buffers up to 1024 events, so memory grows with it.
WORKERS=32
# Time limit for one cache update; the event is still published without it
CACHE_TIMEOUT_MS=10000
# /healthcheck fails when a connected shard received nothing for this long
SHARD_SILENCE_SECS=180

# top.gg stats (optional): with a project token (the bot's top.gg page,
# Integrations & API) the process running shard 0 posts the server count (the
# guilds in the state cache, so it needs STATE_ENABLED) and the shard total to
# top.gg every TOPGG_INTERVAL_SECS (at least 60), the first time one interval
# after the start. Unset, nothing is posted.
# TOPGG_TOKEN=
TOPGG_INTERVAL_SECS=900
